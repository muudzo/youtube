<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.youtube.cleanup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>__REPO_DIR__/cron/cleanup.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_DIR__</string>

    <!-- Safety-net sweep of leftover renders every day at 04:00. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>__REPO_DIR__/output/logs/cleanup.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO_DIR__/output/logs/cleanup.log</string>
</dict>
</plist>
